# Perfil de la prueba de carga de §22.1 (100 usuarios, 30 minutos).
#
# Sale entera de una IP, así que con la ráfaga de producción se mide el límite
# de tasa y no la API. Se usa sólo aquí:
#
#   dotenv -e .env -e .env.load -- pnpm --filter @pagares/api start
#
# No es la configuración normal de desarrollo: `.env` se queda con los valores
# de siempre para que arrancar no dependa de acordarse de nada.
RATE_LIMIT_BURST_PER_MIN=100000
