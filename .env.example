# Copia este archivo como .env y rellena los valores.
# NUNCA se commitea un .env con valores reales (§9.1, API8 · gitleaks en pre-commit).

# ── Entorno ────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Mexico_City
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Base de datos ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pagares:pagares_local@localhost:5432/pagares?schema=public&connection_limit=10

# ── Almacenamiento de objetos (MinIO en local, R2/S3 en producción, §26.3) ─
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=pagares-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── Correo (§16). En local usa Mailpit; en producción, Resend ──────────────
MAIL_DRIVER=mailpit
MAIL_FROM="Pagarés <no-reply@ejemplo.mx>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
# Secreto del webhook de entregas (Svix). Vacío en local: el endpoint responde 503
# en lugar de aceptar cuerpos sin verificar.
RESEND_WEBHOOK_SECRET=

# ── Push a iOS (§24.3). Vacío = canal apagado, sólo correo ─────────────────
# La clave .p8 va en una sola línea con \n en los saltos.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox

# ── Límites de tasa (§25.7) ────────────────────────────────────────────────
# Accesos por IP cada 15 minutos. 10 es el valor de producción; la suite de
# extremo a extremo necesita más porque abre varias sesiones seguidas.
RATE_LIMIT_AUTH_PER_15M=10
# Ráfaga por IP y minuto. La suite de extremo a extremo la supera de largo.
RATE_LIMIT_BURST_PER_MIN=120
# Proxies delante de la API. 0 = acceso directo; 1 = detrás del proxy de Dokploy.
# Sin esto, todos los usuarios comparten IP: un solo cubo de rate limit para
# toda la instalación y la bitácora anotando siempre la misma dirección.
TRUST_PROXY_HOPS=0

# ── Autenticación (§10) ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
TEMP_PASSWORD_TTL_HOURS=72

# ── Primer administrador (§25.1) ───────────────────────────────────────────
# No hacen falta: `pnpm admin:create --email tu@correo.com --name "Tu Nombre"`
# recibe los datos por argumento. Están aquí sólo por si lo automatizas desde un
# provisionador que no puede pasar argumentos.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# ── Notificaciones push a iOS (§24.3) ──────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
